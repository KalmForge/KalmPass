{
  "name": "KalmPass",
  "short_name": "KalmPass",
  "description": "A password manager that cannot read your passwords.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
