{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kalmpass",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-15",

  // The marketing site and the app are both served straight from the edge as
  // static assets. The Worker only ever runs for /api/*, it renders no HTML, so
  // there is no template injection surface anywhere in the product.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "routes": [
    { "pattern": "kalmpass.net", "custom_domain": true },
    { "pattern": "www.kalmpass.net", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kalmpass",
      "database_id": "0be87ac7-bfe4-41f8-8be7-8d2c59379931"
    }
  ],

  // Nightly backups. The bucket deletes anything older than 35 days.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "kalmpass-backups" }],

  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "APP_URL": "https://kalmpass.net",
    "MAIL_FROM": "no-reply@kalmpass.net",
    "MAIL_FROM_NAME": "KalmPass",
    "ALLOW_SIGNUP": "true",
    "PRO_PRICE": "12",
    "PRO_CURRENCY": "USD",
    "PRO_INTERVAL": "year"
  },

  // Nightly housekeeping and a backup of the database to R2.
  "triggers": { "crons": ["17 4 * * *"] },

  "observability": { "enabled": true }
}
